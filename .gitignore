# Python and env
__pycache__/
*.pyc
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs and temp
*.log
.sync-state/

# Parallel worktrees. A worktree nested under the repository is not ignored
# automatically, so without this every later status and diff carries a second
# full checkout as untracked noise.
.claude/worktrees/

# Build output
dist/
build/
obj/
bin/

# Node modules (if ever used)
node_modules/

# Generated by .claude/scripts/generate_registry_digest.py. A consuming project
# builds its own; a copy of the plugin index would be stale everywhere else.
.claude/.scout-cache/
