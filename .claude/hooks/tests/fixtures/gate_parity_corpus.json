{
  "schema": 1,
  "purpose": "The fixed corpus of invariant INV-A1 (Lever A changes no decision) for concept-gate.py: exit code, standard output and standard error of master's copy of the gate must equal the working copy's, step for step. A runner builds one project folder, then walks `steps` in order; both copies of the gate see the folder in the same state at every call, so a contract edited between two calls is edited for both. The successor reuses this file unchanged.",
  "tokens": {
    "${PROJECT_DIR}": "the project folder, forward slashes",
    "${PROJECT_DIR_WIN}": "the project folder, backslashes"
  },
  "ops": {
    "write": "write `text` (a list of lines, joined with a newline, UTF-8) to `path` below the project folder; `mtime` is `old` (a fixed stamp far outside any racy window) or `now`",
    "rewrite_same_size": "in place, replace the bytes `find` with `replace` (equal length, the runner checks it) in `path`; when `restore_mtime` is true the stamp is put back to its exact value from before the rewrite",
    "delete": "remove `path`",
    "call": "start the gate with `payload` (or the raw text `raw`) on standard input and `env` added to the environment; `expect_exit` is what master's copy must exit with, which keeps the corpus itself honest",
    "group": "run `steps` as one unit; when the first call marked `window_mark` has not finished its working-copy run within `window_s` seconds of the unit's start, the unit is undone and run again, at most `retries` times"
  },
  "categories": [
    "worktree-target",
    "trivial-file",
    "non-trivial-file",
    "shell-write",
    "contract-edited-between-calls",
    "same-size-rewrite-in-racy-window"
  ],
  "steps": [
    {"op": "write", "path": "CLAUDE.md", "mtime": "old", "text": ["# parity project", ""]},
    {"op": "write", "path": ".claude/concepts/2026-01-01-parity-covered.md", "mtime": "old", "text": [
      "# Concept Contract - parity covered", "", "**Status:** approved", "", "## Implementation Handoff", "",
      "**Files to touch:**",
      "- `src/ParityCorpus/Covered/Thing.cs`",
      "- `src/ParityCorpus/Covered/Other.cs`",
      "- `src/ParityCorpus/Wild/.../Deep.cs`",
      "- `src/ParityCorpus/Star/*.cs`",
      "", "## Next section", "", "prose", ""]},
    {"op": "write", "path": ".claude/concepts/2026-01-02-parity-draft.md", "mtime": "old", "text": [
      "# Concept Contract - parity draft", "", "**Status:** draft", "", "**Files to touch:**",
      "- `src/ParityCorpus/Draft/Thing.cs`", "", "## Next section", ""]},
    {"op": "write", "path": ".claude/concepts/2026-01-03-parity-archived.md", "mtime": "old", "text": [
      "# Concept Contract - parity archived", "", "**Status:** archived", "", "**Files to touch:**",
      "- `src/ParityCorpus/Archived/Thing.cs`", "", "## Next section", ""]},
    {"op": "write", "path": ".claude/concepts/2026-01-04-parity-implemented.md", "mtime": "old", "text": [
      "# Concept Contract - parity implemented", "", "**Status:** implemented", "", "**Files to touch:**",
      "- `src/ParityCorpus/Implemented/Thing.cs`", "", "## Next section", ""]},
    {"op": "write", "path": ".claude/concepts/2026-01-05-parity-nostatus.md", "mtime": "old", "text": [
      "# Concept Contract - parity without a status line", "", "**Files to touch:**",
      "- `src/ParityCorpus/NoStatus/Thing.cs`", "", "## Next section", ""]},
    {"op": "write", "path": ".claude/worktrees/wt1/.claude/concepts/wt-local.md", "mtime": "old", "text": [
      "# Concept Contract - parity worktree local", "", "**Status:** approved", "", "**Files to touch:**",
      "- `src/ParityCorpus/WtOnly/Thing.cs`", "", "## Next section", ""]},

    {"op": "call", "id": "write-covered", "category": "non-trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Covered/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "edit-covered", "category": "non-trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Edit", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Covered/Other.cs", "old_string": "a", "new_string": "b"}}},
    {"op": "call", "id": "write-uncovered-full-scan", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Uncovered/Nothing.cs", "content": "x"}}},
    {"op": "call", "id": "write-uncovered-backslash-form", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR_WIN}\\src\\ParityCorpus\\Uncovered\\Nothing.cs", "content": "x"}}},
    {"op": "call", "id": "write-draft-only", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Draft/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "write-archived-only", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Archived/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "write-implemented", "category": "non-trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Implemented/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "write-no-status-line", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/NoStatus/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "write-wildcard-deep", "category": "non-trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Wild/a/b/Deep.cs", "content": "x"}}},
    {"op": "call", "id": "write-wildcard-star", "category": "non-trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Star/Any.cs", "content": "x"}}},
    {"op": "call", "id": "write-wildcard-near-miss", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Star/sub/Any.cs", "content": "x"}}},
    {"op": "call", "id": "multiedit-one-uncovered", "category": "non-trivial-file", "expect_exit": 2,
     "payload": {"tool_name": "MultiEdit", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Uncovered/Multi.cs", "edits": [
       {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Covered/Thing.cs", "old_string": "a", "new_string": "b"},
       {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Uncovered/Multi.cs", "old_string": "a", "new_string": "b"}]}}},

    {"op": "call", "id": "worktree-target-covered-by-main", "category": "worktree-target", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/.claude/worktrees/wt1/src/ParityCorpus/Covered/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "worktree-target-covered-by-its-own", "category": "worktree-target", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/.claude/worktrees/wt1/src/ParityCorpus/WtOnly/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "main-target-of-worktree-only-contract", "category": "worktree-target", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/WtOnly/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "worktree-target-uncovered", "category": "worktree-target", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/.claude/worktrees/wt1/src/ParityCorpus/Uncovered/Nothing.cs", "content": "x"}}},
    {"op": "call", "id": "worktree-target-trivial-segment", "category": "worktree-target", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/.claude/worktrees/wt1/.claude/hooks/helper.py", "content": "x"}}},
    {"op": "call", "id": "worktree-target-unknown-worktree", "category": "worktree-target", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/.claude/worktrees/wt9/src/ParityCorpus/WtOnly/Thing.cs", "content": "x"}}},

    {"op": "call", "id": "trivial-markdown", "category": "trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/docs/notes.md", "content": "x"}}},
    {"op": "call", "id": "trivial-json", "category": "trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Edit", "tool_input": {"file_path": "${PROJECT_DIR}/package.json", "old_string": "a", "new_string": "b"}}},
    {"op": "call", "id": "trivial-claude-folder", "category": "trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/.claude/hooks/helper.py", "content": "x"}}},
    {"op": "call", "id": "trivial-claude-md-by-name", "category": "trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/CLAUDE.md", "content": "x"}}},
    {"op": "call", "id": "trivial-build-output-folder", "category": "trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/bin/Debug/x.cs", "content": "x"}}},

    {"op": "call", "id": "shell-write-bash-redirect", "category": "shell-write", "expect_exit": 0,
     "payload": {"tool_name": "Bash", "tool_input": {"command": "echo x > ${PROJECT_DIR}/src/ParityCorpus/Uncovered/Shell.cs"}}},
    {"op": "call", "id": "shell-write-bash-heredoc", "category": "shell-write", "expect_exit": 0,
     "payload": {"tool_name": "Bash", "tool_input": {"command": "cat > ${PROJECT_DIR}/src/ParityCorpus/Uncovered/Heredoc.cs <<'EOF'\nclass A {}\nEOF"}}},
    {"op": "call", "id": "shell-write-powershell", "category": "shell-write", "expect_exit": 0,
     "payload": {"tool_name": "PowerShell", "tool_input": {"command": "Set-Content -Path '${PROJECT_DIR_WIN}\\src\\ParityCorpus\\Uncovered\\Ps.cs' -Value 'x'"}}},
    {"op": "call", "id": "shell-write-sed-in-place", "category": "shell-write", "expect_exit": 0,
     "payload": {"tool_name": "Bash", "tool_input": {"command": "sed -i 's/a/b/' ${PROJECT_DIR}/src/ParityCorpus/Covered/Thing.cs"}}},
    {"op": "call", "id": "tool-read-is-ignored", "category": "shell-write", "expect_exit": 0,
     "payload": {"tool_name": "Read", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Uncovered/Nothing.cs"}}},
    {"op": "call", "id": "tool-notebook-edit-is-ignored", "category": "shell-write", "expect_exit": 0,
     "payload": {"tool_name": "NotebookEdit", "tool_input": {"notebook_path": "${PROJECT_DIR}/src/ParityCorpus/Uncovered/n.ipynb"}}},

    {"op": "call", "id": "stdin-not-json", "category": "non-trivial-file", "expect_exit": 0, "raw": "{not json"},
    {"op": "call", "id": "stdin-empty", "category": "non-trivial-file", "expect_exit": 0, "raw": ""},
    {"op": "call", "id": "stdin-no-path", "category": "non-trivial-file", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"content": "x"}}},
    {"op": "call", "id": "bypass-switch-off", "category": "non-trivial-file", "expect_exit": 0,
     "env": {"CLAUDE_CONCEPT_GATE": "off"},
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Uncovered/Nothing.cs", "content": "x"}}},
    {"op": "call", "id": "pinned-honored-contract-covers", "category": "non-trivial-file", "expect_exit": 0,
     "env": {"CLAUDE_ACTIVE_CONTRACT": "${PROJECT_DIR}/.claude/concepts/2026-01-01-parity-covered.md"},
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Covered/Thing.cs", "content": "x"}}},
    {"op": "call", "id": "pinned-draft-contract-does-not-help", "category": "non-trivial-file", "expect_exit": 2,
     "env": {"CLAUDE_ACTIVE_CONTRACT": "${PROJECT_DIR}/.claude/concepts/2026-01-02-parity-draft.md"},
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Draft/Thing.cs", "content": "x"}}},

    {"op": "write", "path": ".claude/concepts/2026-02-01-parity-edited.md", "mtime": "old", "text": [
      "# Concept Contract - parity edited between calls", "", "**Status:** approved", "", "**Files to touch:**",
      "- `src/ParityCorpus/Edited/A.cs`", "", "## Next section", ""]},
    {"op": "call", "id": "edited-before-a-allowed", "category": "contract-edited-between-calls", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/A.cs", "content": "x"}}},
    {"op": "call", "id": "edited-before-a-allowed-again", "category": "contract-edited-between-calls", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/A.cs", "content": "x"}}},
    {"op": "call", "id": "edited-before-b-blocked", "category": "contract-edited-between-calls", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/B.cs", "content": "x"}}},
    {"op": "write", "path": ".claude/concepts/2026-02-01-parity-edited.md", "mtime": "now", "text": [
      "# Concept Contract - parity edited between calls (edited, longer)", "", "**Status:** approved", "", "**Files to touch:**",
      "- `src/ParityCorpus/Edited/B.cs`", "", "## Next section", "", "an added paragraph", ""]},
    {"op": "call", "id": "edited-after-a-blocked", "category": "contract-edited-between-calls", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/A.cs", "content": "x"}}},
    {"op": "call", "id": "edited-after-b-allowed", "category": "contract-edited-between-calls", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/B.cs", "content": "x"}}},
    {"op": "write", "path": ".claude/concepts/2026-02-01-parity-edited.md", "mtime": "old", "text": [
      "# Concept Contract - parity edited between calls (archived now)", "", "**Status:** archived", "", "**Files to touch:**",
      "- `src/ParityCorpus/Edited/B.cs`", "", "## Next section", ""]},
    {"op": "call", "id": "edited-archived-b-blocked", "category": "contract-edited-between-calls", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/B.cs", "content": "x"}}},
    {"op": "delete", "path": ".claude/concepts/2026-02-01-parity-edited.md"},
    {"op": "call", "id": "edited-deleted-b-blocked", "category": "contract-edited-between-calls", "expect_exit": 2,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/B.cs", "content": "x"}}},
    {"op": "write", "path": ".claude/concepts/2026-02-03-parity-added-later.md", "mtime": "old", "text": [
      "# Concept Contract - parity added later", "", "**Status:** approved", "", "**Files to touch:**",
      "- `src/ParityCorpus/Edited/B.cs`", "", "## Next section", ""]},
    {"op": "call", "id": "edited-added-later-b-allowed", "category": "contract-edited-between-calls", "expect_exit": 0,
     "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Edited/B.cs", "content": "x"}}},

    {"op": "group", "id": "racy-same-size", "window_s": 1.2, "retries": 4, "steps": [
      {"op": "write", "path": ".claude/concepts/2026-02-02-parity-racy.md", "mtime": "now", "text": [
        "# Concept Contract - parity racy", "", "**Status:** approved", "", "**Files to touch:**",
        "- `src/ParityCorpus/Racy/Thing.cs`", "", "## Next section", ""]},
      {"op": "call", "id": "racy-first-call-approved", "category": "same-size-rewrite-in-racy-window", "expect_exit": 0,
       "window_mark": true,
       "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Racy/Thing.cs", "content": "x"}}},
      {"op": "rewrite_same_size", "path": ".claude/concepts/2026-02-02-parity-racy.md",
       "find": "**Status:** approved", "replace": "**Status:** draft   ", "restore_mtime": true},
      {"op": "call", "id": "racy-second-call-draft-same-size", "category": "same-size-rewrite-in-racy-window", "expect_exit": 2,
       "payload": {"tool_name": "Write", "tool_input": {"file_path": "${PROJECT_DIR}/src/ParityCorpus/Racy/Thing.cs", "content": "x"}}}
    ]}
  ]
}
