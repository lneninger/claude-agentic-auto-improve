    },
    {
      "event": "PostToolUse",
      "matcher": "Bash",
      "hook": "codegraph-turn-tracker.py",
      "args": [
        "cli"
      ],
      "if": "Bash(codegraph *)"
    }
  ],
  "prerequisites": [
